# DDS1366 工具默认配置。复制为 .env 后修改；.env 不入库。
# 目标表地址使用示例地址，不要在公开仓库填写现场地址。
METER_ADDRESS=123456789012

# 已储存的目标地址集合（逗号分隔）；设置菜单按后缀匹配切换，当前目标始终保留在集合中
METER_ADDRESSES=123456789012,123456789013

# 串口留空时自动查找 CH340/CH341
PORT=
BAUD=2400
PARITY=E
TX_KEY=rts

# 广播拉/合闸帧的默认组名（两位 HEX，如 AA）；交互中留空时使用
BROADCAST_GROUP=AA

RETRIES=2
RESPONSE_TIMEOUT=1.0

# 共存主站：每个天窗（两次主站通讯之间）最多 3 次；等待主站事务的秒数
COEXIST_PER_WINDOW=3
COEXIST_TXN_WAIT=30
